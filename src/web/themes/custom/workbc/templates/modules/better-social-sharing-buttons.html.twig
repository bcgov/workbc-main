{{ attach_library('better_social_sharing_buttons/styling') }}

<div class="social-sharing-buttons">
  {% for service in items.services %}
    {% if service.enabled %}
      {% include '@better_social_sharing_buttons/partials/' ~ service.id ~ '.html.twig' with {
        items: items,
        social_buttons_sprite: social_buttons_sprite,
        service: service.id
      } %}
    {% endif %}
  {% endfor %}
</div>
